# Local defaults for the compose backend. Overrides from `./scripts/dev.py --env`
# are written to .stack/<project>.env and read after this file.
DATABASE_URL=postgres://acrodont:acrodont@postgres:5432/acrodont
BIND_ADDR=0.0.0.0:8080
MAIL_BACKEND=console
TRUSTED_PROXY_HOPS=1
RUST_LOG=info
# ./scripts/dev.py --login-as: POST /api/dev/login. Never in production, where
# SECURE_COOKIES=true makes the backend refuse to start with it. With it on,
# registration does not close at MAX_ACCOUNTS (backend/src/auth/routes.rs):
# the end-to-end journeys register one account per spec.
DEV_LOGIN=true
